// ═══════════════════ 사후 검증 ═══════════════════

// [1] 명명 통일 — '제주올레' 27 / '제주올레길' 0 이어야 함
MATCH (p:Place) WHERE p.name STARTS WITH '제주올레'
RETURN CASE WHEN p.name STARTS WITH '제주올레길' THEN '★제주올레길(잔여)★' ELSE '제주올레' END AS 표기,
       count(*) AS 건수 ORDER BY 표기;

// [2] 무장애 구간 보유 — 11행. 올레 공식 10개 + 가파도 무장애 순환 코스 1개.
//     FIX43 이후 wheelchairSection 기준과 wheelchairAccess 등급 기준이 같은 10개로 수렴합니다.
//     구간 한정 9 : 01 4.6km중 / 04 4.8km중 / 05 2.7km상 / 06 3.3km중 / 08 3.6km상
//                   10 2.9km중 / 12 1.1km중 / 14 2.1km중 / 17 4.4km중
//     전 구간  1 : 10-1 4.2km하 (가파도)
//     09코스가 나오면 REMOVE 미실행, 08코스가 없으면 이관 미실행입니다.
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE coalesce(ac.wheelchairSection,'') <> ''
RETURN p.name AS 코스, ac.wheelchairSection AS 구간, ac.wheelchairSectionDist AS 거리,
       ac.wheelchairDifficulty AS 난이도, ac.mobilityAccess AS 이동등급,
       ac.recommendForMobility AS 게이트,
       CASE WHEN ac.wheelchairSection STARTS WITH '전 구간' THEN '전구간' ELSE '구간한정' END AS 유형,
       CASE WHEN coalesce(ac.mobilityCaveat,'') = '' THEN '★결측★' ELSE 'OK' END AS 안내문구
ORDER BY 코스;

// [3] 게이트 분포 — Y 849 / N 180 기대
MATCH (ac:Accessibility)
RETURN coalesce(ac.recommendForMobility,'Y') AS 게이트, count(*) AS 건수 ORDER BY 게이트;

// [4] 액티비티 4곳 근거 반영 — 4행, 결측 없어야 함. P951 은 CONDITIONAL + N
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE ac.placeId IN ['P992','P951','P944','P884']
RETURN p.name AS 장소, ac.activityAccess AS 활동참여, ac.recommendForMobility AS 게이트,
       ac.verifyStatus AS 검증상태,
       CASE WHEN coalesce(ac.activityEvidence,'') = '' THEN '★결측★' ELSE 'OK' END AS 근거;

// [5] 게이트와 activityAccess 의 탈동조 확인
//     v3 초기에는 게이트 N 이 activityAccess=UNAVAILABLE 과 1:1 이었으나
//     FIX38 이후 게이트는 파생값이 아니라 독립 판정입니다.
//     세리월드 1건(CONDITIONAL + N)만 나오면 정상입니다.
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE (ac.activityAccess = 'UNAVAILABLE') <> (coalesce(ac.recommendForMobility,'Y') = 'N')
RETURN p.name AS 장소, ac.activityAccess AS 활동참여,
       ac.recommendForMobility AS 게이트, ac.partialReason AS 근거;

// [6] P503 09코스 잔여 속성 제거 확인 — 0행이어야 함
//     ※ verifyStatus='PENDING' 으로는 검증하지 마십시오.
//       숙박시설 17곳이 원래부터 PENDING 입니다.
MATCH (ac:Accessibility {placeId:'P503'})
WHERE ac.wheelchairSection IS NOT NULL OR ac.wheelchairSectionDist IS NOT NULL
   OR ac.wheelchairDifficulty IS NOT NULL OR ac.wheelchairCaveat IS NOT NULL
RETURN '★REMOVE 미실행★' AS 상태, ac.wheelchairSection AS 잔여구간;

// [7] 등급 기준으로도 10개인가 — 10행이어야 함
//     FIX43 이전에는 1-1·7코스가 섞여 12행이 나왔습니다.
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE p.name STARTS WITH '제주올레 '
  AND (coalesce(ac.wheelchairSection,'') <> '' OR ac.wheelchairAccess IN ['FULL','PARTIAL'])
RETURN p.name AS 코스, ac.wheelchairAccess AS 휠체어등급,
       CASE WHEN coalesce(ac.wheelchairSection,'') = '' THEN '★구간없음★'
            WHEN ac.wheelchairSection STARTS WITH '전 구간' THEN '전구간'
            ELSE '구간한정' END AS 유형
ORDER BY 유형, 코스;

// [8] FIX44·FIX45 반영 확인 — 5행, companionRequired 전부 Y
//     가파도 계열 4곳은 '음력' 안내가 들어가야 하고, 마라도는 운항사 안내가 들어가야 합니다.
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE ac.placeId IN ['P884','P915','P914','P416','P896']
RETURN p.name AS 장소, ac.companionRequired AS 동행필요,
       CASE WHEN ac.mobilityCaveat CONTAINS '음력' THEN 'FIX45 OK'
            WHEN ac.mobilityCaveat CONTAINS '아름다운섬나라' THEN 'FIX44 OK'
            ELSE '★미반영★' END AS 안내문구;

// [9] 점검 대상 — 부속섬 관련 Place 중 휠체어 축이 열려 있는 곳
//     여객선 도달 제약이 반영되지 않은 채 시설 접근성만으로 PARTIAL 이 부여된
//     항목이 남아 있는지 확인합니다. FIX44 는 가파도·마라도 계열 4곳만 다뤘습니다.
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE (p.name CONTAINS '우도' OR p.name CONTAINS '추자' OR p.name CONTAINS '마라도'
       OR p.name CONTAINS '가파도')
  AND ac.wheelchairAccess IN ['FULL','PARTIAL']
RETURN p.name AS 장소, ac.wheelchairAccess AS 휠체어등급,
       ac.recommendForMobility AS 게이트,
       CASE WHEN coalesce(ac.mobilityCaveat,'') CONTAINS '승선' THEN '여객선 안내 있음'
            ELSE '★여객선 안내 없음★' END AS 도달제약안내
ORDER BY 도달제약안내 DESC, 장소;

// [10] P951 세리월드 축별 일관성 — 안내문구와 필드값이 맞는지
//      caveat 에 '고령' 제한을 적어놓고 elderlyAccess=FULL 인 상태가 없어야 합니다. 0행 기대.
MATCH (ac:Accessibility {placeId:'P951'})
WHERE ac.mobilityCaveat CONTAINS '고령' AND ac.elderlyAccess = 'FULL'
RETURN '★모순★' AS 상태, ac.elderlyAccess AS 노약자축;

// [11] 섬 소재 Place 의 여객선 속성 결손 점검 — 0행이어야 함
//      섬에 있는데 ferryPort 가 비어 있으면 도달 제약이 Place 레벨에서 잡히지 않습니다.
MATCH (p:Place)
WHERE p.isIsland = 'Y' AND (coalesce(p.ferryPort,'') = '' OR coalesce(p.islandAccessNote,'') = '')
RETURN p.placeId AS 코드, p.name AS 장소, p.islandName AS 섬,
       coalesce(p.ferryPort,'★결측★') AS 항구;

// [12] 가파도 두 경로 분리 확인 — 2행
//      P915 가파도(섬)= 무장애 순환 5.2km / P884 올레 10-1(코스)= 구간 한정
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE p.placeId IN ['P915','P884']
RETURN p.name AS 장소, p.categoryMid AS 분류, ac.wheelchairSection AS 무장애구간,
       coalesce(ac.wheelchairSectionDist,'(거리 미표기)') AS 구간거리, p.note AS 비고;

// [13] 공식 「휠체어 가능여부」 대조 — 10행. 올레_휠체어구간_공식대조표.csv 와 맞춰보십시오.
//      1 4.6km중 / 4 5.5km중 / 5 2.4km상 / 6 2.3km중 / 8 3.4km상
//      10 2.7km중 / 10-1 4.2km상 / 12 1.1km중 / 14 2.1km중 / 17 5.0km중
MATCH (p:Place)-[:HAS_ACCESSIBILITY]->(ac:Accessibility)
WHERE p.name STARTS WITH '제주올레 ' AND coalesce(ac.wheelchairSection,'') <> ''
RETURN p.name AS 코스, ac.wheelchairSectionDist AS 구간거리,
       ac.wheelchairDifficulty AS 휠체어난이도, ac.wheelchairSection AS 구간명,
       CASE WHEN ac.mobilityCaveat CONTAINS '시작점은' THEN 'OK' ELSE '★시작점 누락★' END AS 안내
ORDER BY 코스;
